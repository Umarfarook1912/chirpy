{
  "name": "@chirpy/web",
  "version": "0.0.1",
  "private": true,
  "description": "CHIRPY Web Application — React 18 + Vite",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-ffmpeg.mjs && vite",
    "build": "node scripts/copy-ffmpeg.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/copy-ffmpeg.mjs",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@chirpy/shared": "workspace:*",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@hookform/resolvers": "^3.9.0",
    "@tanstack/react-query": "^5.51.0",
    "@tanstack/react-query-devtools": "^5.51.0",
    "axios": "^1.7.0",
    "lucide-react": "^0.417.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.52.0",
    "react-router-dom": "^6.25.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@ffmpeg/core": "0.12.10",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/ui": "^2.1.9",
    "jsdom": "^30.0.1",
    "sass": "^1.77.0",
    "typescript": "^6.0.3",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
