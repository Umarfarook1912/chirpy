# Backend Environment Variables
# Copy this file to .env and fill in the values

NODE_ENV=development
PORT=3001

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/chirpy?retryWrites=true&w=majority

# JWT secrets — use strong random strings (32+ characters) in production
JWT_SECRET=replace-with-strong-random-secret-min-32-chars
JWT_EXPIRES_IN=15m

REFRESH_SECRET=replace-with-different-strong-random-secret-min-32-chars
REFRESH_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
