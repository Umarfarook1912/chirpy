{
  "name": "@chirpy/extension",
  "version": "0.0.1",
  "private": true,
  "description": "CHIRPY Chrome Extension — MV3",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
